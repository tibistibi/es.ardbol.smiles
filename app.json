{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "es.ardbol.smiles",
  "version": "0.1.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Hoymiles S-Miles Cloud"
  },
  "description": {
    "en": "Control your Hoymiles microinverters through the S-Miles Cloud — no local connection to the DTU needed.",
    "nl": "Stuur je Hoymiles micro-omvormers aan via de S-Miles Cloud — geen lokale verbinding met de DTU nodig.",
    "es": "Controla tus microinversores Hoymiles a través de S-Miles Cloud — sin conexión local con la DTU."
  },
  "category": [
    "energy"
  ],
  "permissions": [],
  "brandColor": "#E8501C",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Tibor Strausz"
  },
  "contributors": {
    "developers": [
      {
        "name": "ItsRaYnor (S-Miles login, from homey-app-hoymiles-hione)"
      }
    ]
  },
  "source": "https://github.com/tibistibi/es.ardbol.smiles",
  "bugs": {
    "url": "https://github.com/tibistibi/es.ardbol.smiles/issues"
  },
  "support": "https://github.com/tibistibi/es.ardbol.smiles/issues",
  "flow": {
    "actions": [
      {
        "title": {
          "en": "Set max output",
          "nl": "Zet max. uitvoer",
          "es": "Fijar salida máx."
        },
        "titleFormatted": {
          "en": "Set max output to [[kw]] kW",
          "nl": "Zet max. uitvoer op [[kw]] kW",
          "es": "Fijar salida máx. a [[kw]] kW"
        },
        "hint": {
          "en": "Only sends a command when the value differs from the last one set, to spare the DTU/inverter flash memory.",
          "nl": "Stuurt alleen een commando als de waarde afwijkt van de vorige, om het flashgeheugen van DTU/omvormer te sparen.",
          "es": "Solo envía un comando si el valor difiere del anterior, para cuidar la memoria flash de la DTU/inversor."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=station"
          },
          {
            "type": "number",
            "name": "kw",
            "min": -10,
            "max": 100,
            "step": 0.01,
            "placeholder": {
              "en": "kW"
            }
          }
        ],
        "id": "set_output_limit"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "S-Miles station",
        "nl": "S-Miles installatie",
        "es": "Instalación S-Miles"
      },
      "class": "solarpanel",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "measure_power",
        "meter_power",
        "meter_power.today",
        "smiles_output_limit"
      ],
      "capabilitiesOptions": {
        "meter_power": {
          "title": {
            "en": "Total yield",
            "nl": "Totale opbrengst",
            "es": "Producción total"
          }
        },
        "meter_power.today": {
          "title": {
            "en": "Yield today",
            "nl": "Opbrengst vandaag",
            "es": "Producción hoy"
          }
        }
      },
      "energy": {
        "meterPowerExportedCapability": "meter_power"
      },
      "images": {
        "small": "/drivers/station/assets/images/small.png",
        "large": "/drivers/station/assets/images/large.png",
        "xlarge": "/drivers/station/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "logo": "../../../assets/icon.svg",
            "usernameLabel": {
              "en": "S-Miles e-mail"
            },
            "usernamePlaceholder": {
              "en": "homey@example.com"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "logo": "../../../assets/icon.svg"
          }
        }
      ],
      "id": "station"
    }
  ],
  "capabilities": {
    "smiles_output_limit": {
      "type": "number",
      "title": {
        "en": "Max output",
        "nl": "Max. uitvoer",
        "es": "Salida máx."
      },
      "units": {
        "en": "kW"
      },
      "decimals": 1,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/limit.svg",
      "insights": true
    }
  }
}