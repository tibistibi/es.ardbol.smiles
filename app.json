{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "es.ardbol.smiles",
  "version": "0.2.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Hoymiles S-Miles Cloud"
  },
  "description": {
    "en": "Control your Hoymiles microinverters through the S-Miles Cloud — no local connection to the DTU needed.",
    "nl": "Stuur je Hoymiles micro-omvormers aan via de S-Miles Cloud — geen lokale verbinding met de DTU nodig.",
    "es": "Controla tus microinversores Hoymiles a través de S-Miles Cloud — sin conexión local con la DTU."
  },
  "category": [
    "energy"
  ],
  "permissions": [],
  "brandColor": "#E8501C",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Tibor Strausz"
  },
  "contributors": {
    "developers": [
      {
        "name": "ItsRaYnor (S-Miles login, from homey-app-hoymiles-hione)"
      },
      {
        "name": "Eistee82 (cloud device commands, from ioBroker.hoymiles)"
      }
    ]
  },
  "source": "https://github.com/tibistibi/es.ardbol.smiles",
  "bugs": {
    "url": "https://github.com/tibistibi/es.ardbol.smiles/issues"
  },
  "support": "https://github.com/tibistibi/es.ardbol.smiles/issues",
  "flow": {
    "actions": [
      {
        "title": {
          "en": "Turn inverter on/off",
          "nl": "Zet omvormer aan/uit",
          "es": "Encender/apagar inversor"
        },
        "titleFormatted": {
          "en": "Turn inverters [[state]]",
          "nl": "Zet omvormers [[state]]",
          "es": "[[state]] inversores"
        },
        "hint": {
          "en": "Switches all micro-inverters of this installation on or off via the cloud; no DTU-Pro or meter needed (e.g. HMS-800-2WB). Only sends a command when the state differs from the last one set by Homey.",
          "nl": "Zet alle micro-omvormers van deze installatie via de cloud aan of uit; geen DTU-Pro of meter nodig (bijv. HMS-800-2WB). Stuurt alleen een commando als de stand afwijkt van de vorige die Homey zette.",
          "es": "Enciende o apaga todos los microinversores de esta instalación a través de la nube; sin DTU-Pro ni medidor (p. ej. HMS-800-2WB). Solo envía un comando si el estado difiere del último fijado por Homey."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=station"
          },
          {
            "type": "dropdown",
            "name": "state",
            "values": [
              {
                "id": "on",
                "label": {
                  "en": "on",
                  "nl": "aan",
                  "es": "Encender"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "off",
                  "nl": "uit",
                  "es": "Apagar"
                }
              }
            ]
          }
        ],
        "id": "set_inverter_onoff"
      },
      {
        "title": {
          "en": "Set max output",
          "nl": "Zet max. uitvoer",
          "es": "Fijar salida máx."
        },
        "titleFormatted": {
          "en": "Set max output to [[kw]] kW",
          "nl": "Zet max. uitvoer op [[kw]] kW",
          "es": "Fijar salida máx. a [[kw]] kW"
        },
        "hint": {
          "en": "Only sends a command when the value differs from the last one set, to spare the DTU/inverter flash memory.",
          "nl": "Stuurt alleen een commando als de waarde afwijkt van de vorige, om het flashgeheugen van DTU/omvormer te sparen.",
          "es": "Solo envía un comando si el valor difiere del anterior, para cuidar la memoria flash de la DTU/inversor."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=station"
          },
          {
            "type": "number",
            "name": "kw",
            "min": -10,
            "max": 100,
            "step": 0.01,
            "placeholder": {
              "en": "kW"
            }
          }
        ],
        "id": "set_output_limit"
      },
      {
        "title": {
          "en": "Set power limit",
          "nl": "Zet limiet",
          "es": "Fijar límite de potencia"
        },
        "titleFormatted": {
          "en": "Set power limit to [[percent]] %",
          "nl": "Zet limiet op [[percent]] %",
          "es": "Fijar límite de potencia a [[percent]] %"
        },
        "hint": {
          "en": "Caps the output of all micro-inverters of this installation at a percentage of their rated power (2–100 %); no meter needed. Only sends on change and at most once per minute: every limit is written to DTU/inverter flash.",
          "nl": "Begrenst de uitvoer van alle micro-omvormers van deze installatie op een percentage van hun nominale vermogen (2–100 %); geen meter nodig. Stuurt alleen bij wijziging en max. 1× per minuut: elke limiet wordt in het flashgeheugen van DTU/omvormer geschreven.",
          "es": "Limita la salida de todos los microinversores de esta instalación a un porcentaje de su potencia nominal (2–100 %); sin medidor. Solo envía si cambia y como máximo una vez por minuto: cada límite se escribe en la memoria flash de la DTU/inversor."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=station"
          },
          {
            "type": "number",
            "name": "percent",
            "min": 2,
            "max": 100,
            "step": 1,
            "placeholder": {
              "en": "%"
            }
          }
        ],
        "id": "set_power_limit_pct"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "S-Miles station",
        "nl": "S-Miles installatie",
        "es": "Instalación S-Miles"
      },
      "class": "solarpanel",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "measure_power",
        "meter_power",
        "meter_power.today",
        "smiles_output_limit"
      ],
      "capabilitiesOptions": {
        "meter_power": {
          "title": {
            "en": "Total yield",
            "nl": "Totale opbrengst",
            "es": "Producción total"
          }
        },
        "meter_power.today": {
          "title": {
            "en": "Yield today",
            "nl": "Opbrengst vandaag",
            "es": "Producción hoy"
          }
        }
      },
      "energy": {
        "meterPowerExportedCapability": "meter_power"
      },
      "images": {
        "small": "/drivers/station/assets/images/small.png",
        "large": "/drivers/station/assets/images/large.png",
        "xlarge": "/drivers/station/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "logo": "../../../assets/icon.svg",
            "usernameLabel": {
              "en": "S-Miles e-mail"
            },
            "usernamePlaceholder": {
              "en": "homey@example.com"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "logo": "../../../assets/icon.svg"
          }
        }
      ],
      "id": "station"
    }
  ],
  "capabilities": {
    "smiles_output_limit": {
      "type": "number",
      "title": {
        "en": "Max output",
        "nl": "Max. uitvoer",
        "es": "Salida máx."
      },
      "units": {
        "en": "kW"
      },
      "decimals": 1,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/limit.svg",
      "insights": true
    }
  }
}