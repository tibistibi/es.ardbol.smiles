{
  "name": { "en": "S-Miles station", "nl": "S-Miles installatie", "es": "Instalación S-Miles" },
  "class": "solarpanel",
  "platforms": ["local"],
  "connectivity": ["cloud"],
  "capabilities": ["measure_power", "meter_power", "meter_power.today", "smiles_output_limit"],
  "capabilitiesOptions": {
    "meter_power": { "title": { "en": "Total yield", "nl": "Totale opbrengst", "es": "Producción total" } },
    "meter_power.today": { "title": { "en": "Yield today", "nl": "Opbrengst vandaag", "es": "Producción hoy" } }
  },
  "energy": { "meterPowerExportedCapability": "meter_power" },
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    { "id": "login_credentials", "template": "login_credentials", "options": { "logo": "../../../assets/icon.svg", "usernameLabel": { "en": "S-Miles e-mail" }, "usernamePlaceholder": { "en": "homey@example.com" } } },
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ],
  "repair": [
    { "id": "login_credentials", "template": "login_credentials", "options": { "logo": "../../../assets/icon.svg" } }
  ]
}
